rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // =========================================================================
    // Helper: verify the authenticated user owns this path.
    // =========================================================================
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // =========================================================================
    // Deny all access by default — only explicitly matched paths below are
    // accessible.
    // =========================================================================
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // users/{uid}/stamps/{stampId}/{fileName}
    //
    // Stamp images — only the owning user may read or write.
    //   - Maximum file size: 2 MB
    //   - Allowed content types: PNG, JPEG, SVG
    // =========================================================================
    match /users/{uid}/stamps/{stampId}/{fileName} {
      allow read: if isOwner(uid);

      allow write: if isOwner(uid)
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|svg\\+xml)');
    }

    // =========================================================================
    // users/{uid}/files/{fileName}
    //
    // Uploaded PDF files — only the owning user may read or write.
    //   - Maximum file size: 10 MB
    //   - Allowed content type: application/pdf
    // =========================================================================
    match /users/{uid}/files/{fileName} {
      allow read: if isOwner(uid);

      allow write: if isOwner(uid)
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }
  }
}
